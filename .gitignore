__pycache__/
*.pyc
.pytest_cache/
data/
runs/
*.egg-info/
.venv/
web/node_modules/
.freebuff/
pics/
inputs.txt
.postman
postman

# Local datasets — kept on disk for reproducibility, never pushed
data/SECOND/
data/CDVQA/
data/LEVIR-CD/
data/bigearthnet_14k*
data/eurosat/
data/rsvqa_lr/
data/vrsbench/
data/bentxt_join/
data/satquery.db

# The unanchored `data/` rule above also matches nested directories, which
# would silently drop the small generated indexes the acquisition layer ships:
# the ISRO/Bhuvan layer index (~135 KB) and the offline place gazetteer. These
# are code-adjacent data, not datasets, and the app cannot resolve a place or
# select an ISRO layer without them. Re-included explicitly, after `data/`.
!satquery/acquire/data/
!satquery/acquire/data/**

# Model checkpoints: large binaries stay local; only the demo-critical
# promoted checkpoints (counting head, CDVQA head) and TorchScript exports
# are tracked.
# Local-only backups taken before a calibration re-fit. Never tracked: the
# re-fit is reproducible with scripts/calibrate.py.
weights/_precal_backup/
weights/*.pt
!weights/count_head.pt
!weights/cdvqa_head.pt
weights/*_cache_*.json

# Scratch / temp outputs
# Cached upstream documents (Bhuvan capabilities, place-index build log)
.cache/
*.log
gitstatus.txt
cdvqa_full_out.txt
cdvqa_full_results.txt

# Internal planning & strategy + local AI-context files (never tracked, never pushed)
MASTERPLAN.md
system docs/

# Local SIH submission bridge (deployed separately)
hub/
